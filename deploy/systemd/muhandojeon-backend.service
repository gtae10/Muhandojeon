[Unit]
Description=Muhandojeon 팀 백엔드 (backend/, FastAPI, :8103)
After=network.target

[Service]
Type=simple
User=muhandojeon
Group=muhandojeon
WorkingDirectory=/opt/muhandojeon/main/backend
EnvironmentFile=/opt/muhandojeon/main/backend/.env
ExecStart=/opt/muhandojeon/main/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8103 --workers 1
Restart=on-failure
RestartSec=3
MemoryMax=1024M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
