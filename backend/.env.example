# ─────────────────────────────────────────────
# .env.example - 환경 변수 템플릿
# 실제 사용 시 이 파일을 .env 로 복사하고 값을 채우세요.
# cp .env.example .env
# ─────────────────────────────────────────────

# [필수] OpenAI API Key
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [선택] 사용할 모델 (기본값: gpt-4o)
OPENAI_MODEL=gpt-4o

# [선택] 최대 응답 토큰 수
OPENAI_MAX_TOKENS=1024

# [선택] DB 연결 URL (기본값: SQLite)
# SQLite (개발용, 파일로 저장)
DATABASE_URL=sqlite+aiosqlite:///./luxury_clienteling.db

# PostgreSQL (운영용, 아래 형식으로 변경)
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/luxury_clienteling
