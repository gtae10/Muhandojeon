# ── 어댑터 전환 ────────────────────────────────────────────────
# 전역 기본값. 팀원 모듈이 하나씩 완성되면 모듈별 오버라이드로 부분 전환한다.
ADAPTER_MODE=mock
# INTENT_ADAPTER=http
# CLIENTELING_ADAPTER=http
# ASSET_ADAPTER=http
# FINGERPRINT_ADAPTER=http
# CONDITION_ADAPTER=http

# 팀원 모듈 업스트림 주소 (http 모드에서만 사용)
INTENT_BASE_URL=http://localhost:8101
CLIENTELING_BASE_URL=http://localhost:8102
ASSET_BASE_URL=http://localhost:8103
FINGERPRINT_BASE_URL=http://localhost:8104
CONDITION_BASE_URL=http://localhost:8105

# ── 시드 데이터 ────────────────────────────────────────────────
# 외부 데이터셋 미확정 → 손으로 쓴 fixtures/*.json 이 기본.
# 데이터셋 확정 후 DatasetProvider 를 구현하고 dataset 으로 바꾼다.
SEED_SOURCE=fixture

# ── LLM (OpenAI 호환, 텍스트 전용 — 비전 없음) ──────────────────
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
# 상위 티어(상담·심판). 대회 API 의 실제 모델명으로 바꾼다.
LLM_MODEL=gpt-4o
# 저가 티어(페르소나·분류·컨디션 소견). 비면 LLM_MODEL 을 그대로 쓴다 → 절감 효과가 사라진다.
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_JUDGE_MODEL=
LLM_TEMPERATURE=0
LLM_SEED=42
# 캐시는 기본 ON. 끄면 같은 프롬프트도 매번 과금된다(예산 사고의 1순위 원인).
LLM_CACHE_ENABLED=true
# true 면 실제 호출 없이 토큰·비용만 추정한다 (make estimate)
LLM_DRY_RUN=false
LLM_MAX_CONCURRENCY=4
# /models 조회로 실제 모델명 채우기(1회 후 캐시). 실패 시 위 env 값을 쓴다.
LLM_MODELS_DISCOVERY=true

# ── 예산 (총액 100달러, 초과 시 복구 수단 없음) ──────────────────
LLM_BUDGET_TOTAL_USD=100
LLM_BUDGET_WARN_USD=60
LLM_BUDGET_HARD_USD=85
# 세션 원가 원화 환산용 고정 환율(실시간 조회 안 함)
USD_KRW=1380

# ── 데모 안정화 ────────────────────────────────────────────────
DEMO_MODE=false
UPSTREAM_TIMEOUT_SECONDS=5.0
UPSTREAM_RETRIES=1
LAB_CONCURRENCY=4
LAB_RUNS_PER_PAIR=3
