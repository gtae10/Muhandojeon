# 이 파일을 복사해서 .env 로 이름을 바꾸고, 실제 값을 넣으세요.
# .env 는 .gitignore 에 등록되어 있어 GitHub에 올라가지 않습니다.

# 필수 — platform.openai.com 에서 발급 (sk-proj- 로 시작)
OPENAI_API_KEY=sk-proj-여기에_실제_키를_붙여넣기

# 선택 — 비워두면 gpt-4o 를 씁니다 (데모 모델, 코드 기본값과 같음).
# 데모는 gpt-4o 입니다. 긴 대화 품질이 mini 보다 안정적입니다 (2026-08-18 실측).
# 개발·회귀를 싸게 돌리려면 gpt-4o-mini 로 바꾸세요 (비용 약 1/20).
# 주의: gpt-4o 는 분당 30,000 토큰 제한 — 여러 명이 동시에 돌리면 재시도로 느려집니다.
OPENAI_MODEL=gpt-4o

# 선택 — 비워두면 OpenAI 기본 서버로 갑니다.
# 팀 자체 게이트웨이를 쓰게 되면 그 주소를 여기에 넣으세요.
# OPENAI_BASE_URL=
